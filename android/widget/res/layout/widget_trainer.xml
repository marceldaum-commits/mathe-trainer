<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/widget_kopf" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/widget_name" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="@string/widget_name" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_kicker" android:textColor="#73E0A9" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_formel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="3" android:ellipsize="end"
        android:lineSpacingExtra="2dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_tag" style="@style/WidgetKnopf" android:background="@drawable/widget_knopf_haupt"
            android:text="@string/widget_tag" />
        <TextView android:id="@+id/widget_abenteuer" style="@style/WidgetKnopf" android:layout_marginStart="6dp"
            android:background="@drawable/widget_knopf" android:text="@string/widget_abenteuer" />
        <TextView android:id="@+id/widget_wiederholen" style="@style/WidgetKnopf" android:layout_marginStart="6dp"
            android:background="@drawable/widget_knopf" android:text="@string/widget_wiederholen" />
    </LinearLayout>
</LinearLayout>
